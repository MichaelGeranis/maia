<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Backup is off: the plan is encrypted with a key held in the Android Keystore, which is neither backed up nor
      moved to a new phone. Files copied without the key would leave the parent with an unreadable plan.
      allowBackup="false" covers Android 11 and older; from Android 12 it no longer stops a device-to-device
      transfer, so dataExtractionRules (Resources/xml) excludes everything from cloud backup and device transfer too.
      Moving phones goes through her encrypted backup file (ADR 0005).
    -->
    <application android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>
    <!--
      No INTERNET or ACCESS_NETWORK_STATE: the free app works offline and never talks to a server. Backups and
      shared results leave through the share sheet. Debug builds get INTERNET from the SDK for the debugger.
      Add both back only with the paid cloud backup.
    -->
    <!--
      Reminders on this phone (Settings, or setup step 3): notifications, asked for (Android 13+) only when she turns them
      on, and setting them again after the phone restarts. Alarms are inexact (setAndAllowWhileIdle), so no exact-alarm permission.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      "Lock Maia with your screen lock" (off by default) asks for the phone's own screen lock through the system prompt
      (Android 11 and later), which needs this install-time permission. Maia never sees the PIN, pattern or fingerprint.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      Breathe's gentle vibration at the start of each breath in and out (on until she turns it off on Breathe). An
      install-time permission; Breathe never vibrates on silent or in Do not disturb.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Package visibility: the dialer (call her OB-GYN or another of her doctors), the contact picker and the camera app
      for "Take a photo". Maia holds no CAMERA permission: the camera app takes the photo and writes it into Maia's
      private cache through its file provider. Declaring CAMERA would make that intent need it too.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
