<?xml version="1.0" encoding="utf-8" ?>
<!--
  Licences, pushed from About Maia. No screenshot: the Settings layout with three cards (fonts, icons, libraries) of rows. A
  row's licence text opens in place, on the pale panel an open check card uses for its results.
-->
<controls:MaiaPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:loc="clr-namespace:Maia.App.Localization"
                   xmlns:controls="clr-namespace:Maia.App.Controls"
                   xmlns:vm="clr-namespace:Maia.Presentation.About;assembly=Maia.Presentation"
                   x:Class="Maia.App.Views.LicencesPage"
                   x:DataType="vm:LicencesViewModel">
    <ContentPage.Resources>
        <DataTemplate x:Key="LicenceRow" x:DataType="vm:LicenceItem">
            <VerticalStackLayout Spacing="4" Padding="0,12">
                <Label Text="{Binding Name}" Style="{StaticResource Heading}" />
                <Label Text="{Binding Licence}" Style="{StaticResource CaptionStrong}" TextColor="{StaticResource Sea}" />
                <Label Text="{Binding Copyright}" Style="{StaticResource Caption}" />
                <Button Text="{Binding ToggleText}" Style="{StaticResource LinkButton}" Command="{Binding ToggleCommand}" />
                <Border BackgroundColor="{StaticResource Mist}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12"
                        IsVisible="{Binding IsOpen}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding PackageList}" Style="{StaticResource Caption}" IsVisible="{Binding HasPackages}" />
                        <Label Text="{Binding FullText}" Style="{StaticResource Caption}" TextColor="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20,44,20,28" Spacing="16" controls:Motions.Rise="True">
            <controls:BackPill Command="{Binding BackCommand}" HorizontalOptions="Start" />

            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Translate Licences_Title}" Style="{StaticResource Title}" />
                <Label Text="{loc:Translate Licences_Intro}" Style="{StaticResource Body}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="18,10">
                <VerticalStackLayout>
                    <Label Text="{loc:Translate Licences_Fonts}" Style="{StaticResource GroupEyebrow}" Margin="0,8,0,0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fonts}" BindableLayout.ItemTemplate="{StaticResource LicenceRow}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,10">
                <VerticalStackLayout>
                    <Label Text="{loc:Translate Licences_Icons}" Style="{StaticResource GroupEyebrow}" Margin="0,8,0,0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Icons}" BindableLayout.ItemTemplate="{StaticResource LicenceRow}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,10">
                <VerticalStackLayout>
                    <Label Text="{loc:Translate Licences_Libraries}" Style="{StaticResource GroupEyebrow}" Margin="0,8,0,0" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Libraries}" BindableLayout.ItemTemplate="{StaticResource LicenceRow}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</controls:MaiaPage>
