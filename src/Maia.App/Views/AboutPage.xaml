<?xml version="1.0" encoding="utf-8" ?>
<!--
  About Maia, pushed from Settings. No screenshot: built from Settings' parts (Back pill, title, body, row cards with a
  tile and a chevron, as Settings' About Maia row).
-->
<controls:MaiaPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:loc="clr-namespace:Maia.App.Localization"
                   xmlns:controls="clr-namespace:Maia.App.Controls"
                   xmlns:vm="clr-namespace:Maia.Presentation.About;assembly=Maia.Presentation"
                   x:Class="Maia.App.Views.AboutPage"
                   x:DataType="vm:AboutViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="20,44,20,28" Spacing="16" controls:Motions.Rise="True">
            <controls:BackPill Command="{Binding BackCommand}" HorizontalOptions="Start" />

            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Translate About_Title}" Style="{StaticResource Title}" />
                <Label Text="{loc:Translate About_Intro}" Style="{StaticResource Body}" />
                <Label Text="{Binding Version}" Style="{StaticResource CaptionStrong}" Margin="0,4,0,0" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="16,14" controls:Accessible.Role="Button">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource SageTint}" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <controls:Icon Data="{StaticResource IconPrivacy}" Size="18" Color="{StaticResource Pine}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{loc:Translate About_Privacy}" Style="{StaticResource Heading}" />
                        <Label Text="{loc:Translate About_PrivacyHint}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <controls:Icon Grid.Column="2" Data="{StaticResource IconChevronRight}" Size="18" Color="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14" controls:Accessible.Role="Button">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTermsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource SageTint}" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <controls:Icon Data="{StaticResource IconTerms}" Size="18" Color="{StaticResource Pine}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{loc:Translate About_Terms}" Style="{StaticResource Heading}" />
                        <Label Text="{loc:Translate About_TermsHint}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <controls:Icon Grid.Column="2" Data="{StaticResource IconChevronRight}" Size="18" Color="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,14" controls:Accessible.Role="Button">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenLicencesCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource SageTint}" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <controls:Icon Data="{StaticResource IconFile}" Size="18" Color="{StaticResource Pine}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{loc:Translate About_Licences}" Style="{StaticResource Heading}" />
                        <Label Text="{loc:Translate About_LicencesHint}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                    <controls:Icon Grid.Column="2" Data="{StaticResource IconChevronRight}" Size="18" Color="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</controls:MaiaPage>
