<?xml version="1.0" encoding="utf-8" ?>
<!--
  The lock screen, shown over everything while Maia is locked ("Lock Maia with your screen lock" in Settings). No
  screenshot: built from the setup screens' parts (the misty background, a sprout on a Sky tile, setup title, body,
  primary button) and the Sand note Settings uses. It shows nothing from her plan. A view, not a page: it is shown in a
  window of its own over Maia (see AppLockPresenter), so the pages underneath never close or load again.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Maia.App.Localization"
             xmlns:controls="clr-namespace:Maia.App.Controls"
             xmlns:vm="clr-namespace:Maia.Presentation.Privacy;assembly=Maia.Presentation"
             x:Class="Maia.App.Views.LockView"
             x:DataType="vm:LockViewModel">
    <Grid>
        <controls:MaiaBackground />
        <ScrollView>
            <VerticalStackLayout Padding="20,44,20,28" Spacing="16" VerticalOptions="Center">
                <controls:Logo Size="48" HorizontalOptions="Start" />
                <Label Text="{loc:Translate Lock_Title}" Style="{StaticResource Title}" Margin="0,8,0,0" />
                <Label Text="{loc:Translate Lock_Intro}" Style="{StaticResource Body}" />
                <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource Sand}" StrokeShape="RoundRectangle 14" Padding="14,12" HorizontalOptions="Fill"
                        IsVisible="{Binding Notice, Converter={StaticResource IsNotNull}}">
                    <Label Style="{StaticResource Body}" Text="{Binding Notice}" controls:Accessible.Announce="True" TextColor="{StaticResource SandDeep}" />
                </Border>
                <Button Text="{loc:Translate Lock_Unlock}" Style="{StaticResource PrimaryButton}" Command="{Binding UnlockCommand}" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
