<?xml version="1.0" encoding="utf-8" ?>
<!--
  Journey. Design: docs/design/screens/05-journey.jpg and 06-entry-opened.jpg (an entry opened in place). Each pregnancy
  week has its heading across the timeline ("Week 25", a hairline, "11–17 Oct"), where the line pauses for it, and one
  with nothing in it says so. Her blood pressure readings stand small on the line at the day and time she took them.
-->
<controls:MaiaPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   xmlns:loc="clr-namespace:Maia.App.Localization"
                   xmlns:controls="clr-namespace:Maia.App.Controls"
                   xmlns:views="clr-namespace:Maia.App.Views"
                   xmlns:vm="clr-namespace:Maia.Presentation.Plan;assembly=Maia.Presentation"
                   xmlns:add="clr-namespace:Maia.Presentation.Add;assembly=Maia.Presentation"
                   x:Class="Maia.App.Views.PlanPage"
                   x:DataType="vm:PlanViewModel"
                   Tab="plan">
    <controls:MaiaPage.Resources>
        <!-- Trimester heading: leaf and name. -->
        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:SectionRow">
            <HorizontalStackLayout Spacing="10" Padding="0,20,0,8">
                <controls:Icon Data="{StaticResource IconLeaf}" Size="18" Color="{StaticResource Sage}" />
                <Label Text="{Binding Title}" Style="{StaticResource GroupEyebrow}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </DataTemplate>

        <!-- A week's heading across the timeline: "Week 25" in Pine, a hairline, "11–17 Oct" in Muted. The line pauses
             for it; under a week with nothing in it, "Nothing this week" beside the line. -->
        <DataTemplate x:Key="WeekTemplate" x:DataType="vm:WeekRow">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,14,0,6"
                      SemanticProperties.HeadingLevel="Level3" SemanticProperties.Description="{Binding SpokenName}">
                    <Label Text="{Binding Title}" Style="{StaticResource Label}" TextColor="{StaticResource Pine}" VerticalOptions="Center" />
                    <ContentView Grid.Column="1" HeightRequest="1" BackgroundColor="{StaticResource Line}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="{Binding Dates}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                </Grid>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" IsVisible="{Binding IsEmpty}">
                    <ContentView WidthRequest="2" BackgroundColor="{StaticResource Line}" IsVisible="{Binding LineBelow}" />
                    <Label Grid.Column="1" Text="{loc:Translate Plan_EmptyWeek}" Style="{StaticResource Caption}" Padding="0,2,0,8" />
                </Grid>
            </VerticalStackLayout>
        </DataTemplate>

        <!-- You are here: a glowing sea-blue node and a Sky pill. -->
        <DataTemplate x:Key="HereTemplate" x:DataType="vm:HereRow">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                <Grid RowDefinitions="22,*">
                    <ContentView WidthRequest="2" BackgroundColor="{StaticResource Line}" IsVisible="{Binding LineAbove}" />
                    <ContentView Grid.Row="1" WidthRequest="2" BackgroundColor="{StaticResource Line}" IsVisible="{Binding LineBelow}" />
                    <controls:PulseRing Grid.RowSpan="2" WidthRequest="30" HeightRequest="30" VerticalOptions="Start" Margin="0,7,0,0" />
                    <Ellipse Grid.RowSpan="2" WidthRequest="30" HeightRequest="30" Fill="{StaticResource Sky}" VerticalOptions="Start" Margin="0,7,0,0" />
                    <Ellipse Grid.RowSpan="2" WidthRequest="18" HeightRequest="18" Fill="{StaticResource Sea}" Stroke="{StaticResource Mist}"
                             StrokeThickness="4" VerticalOptions="Start" Margin="0,13,0,0" />
                </Grid>
                <controls:LightBorder Grid.Column="1" Style="{StaticResource Chip}" BackgroundColor="{StaticResource Sky}" StrokeShape="RoundRectangle 20"
                                      Padding="14,9" HorizontalOptions="Fill" Margin="0,3">
                    <Label Style="{StaticResource Label}" Text="{Binding Text}" TextColor="{StaticResource SkyDeep}" />
                </controls:LightBorder>
            </Grid>
        </DataTemplate>

        <!-- An entry's detail: note, then Book or Edit, and Delete. Built only while its card is open (LazyView), so a
             collapsed row carries no pickers, fields or buttons. -->
        <DataTemplate x:Key="CheckDetailTemplate" x:DataType="vm:CheckRow">
            <VerticalStackLayout Padding="16,0,16,16" Spacing="10">
                <Label Style="{StaticResource Caption}" Text="{Binding Note}" TextColor="{StaticResource Muted}" IsVisible="{Binding HasNote}" />

                <!--
                  Not booked: "Book" and "Delete". Booked or done: "Edit" and "Delete". The two share the row, or stand one
                  under the other when a word would not fit its half on one line (ButtonRow).
                -->
                <VerticalStackLayout IsVisible="{Binding ShowsActions}" controls:Accessible.FocusWhenShown="True">
                    <controls:ButtonRow ColumnSpacing="8" IsVisible="{Binding CanBook}">
                        <Button Text="{loc:Translate Check_Book}" Style="{StaticResource MarkDoneButton}" Command="{Binding StartBookCommand}" />
                        <Button Text="{loc:Translate Check_Delete}" Style="{StaticResource NotNeededButton}" Command="{Binding AskDeleteCommand}" />
                    </controls:ButtonRow>
                    <controls:ButtonRow ColumnSpacing="8" IsVisible="{Binding CanBook, Converter={StaticResource InvertedBool}}">
                        <Button Text="{loc:Translate Check_Edit}" Style="{StaticResource MarkDoneButton}" Command="{Binding StartEditCommand}" />
                        <Button Text="{loc:Translate Check_Delete}" Style="{StaticResource NotNeededButton}" Command="{Binding AskDeleteCommand}" />
                    </controls:ButtonRow>
                </VerticalStackLayout>

                <!-- Book (a day and a time) or Edit (its name, its note, and when), then save or cancel. -->
                <Border BackgroundColor="{StaticResource Mist}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12"
                        IsVisible="{Binding IsChanging}" controls:Accessible.FocusWhenShown="True">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditing}">
                            <Label Text="{loc:Translate Add_Name}" Style="{StaticResource Eyebrow}" CharacterSpacing="0.96" TextColor="{StaticResource SkyDeep}" />
                            <Border Style="{StaticResource Field}">
                                <Entry Keyboard="Text" Text="{Binding EditName}" TextColor="{StaticResource Ink}" ReturnType="Done"
                                       MaxLength="{x:Static add:AddEntryViewModel.MaxNameLength}" SemanticProperties.Description="{loc:Translate Add_Name}"/>
                            </Border>
                            <Label Text="{loc:Translate Add_Note}" Style="{StaticResource Eyebrow}" CharacterSpacing="0.96" TextColor="{StaticResource SkyDeep}" />
                            <Border Style="{StaticResource Field}" Padding="10,4">
                                <Editor Keyboard="Text" Text="{Binding EditNote}" Placeholder="{loc:Translate Add_NotePlaceholder}" TextColor="{StaticResource Ink}"
                                        AutoSize="TextChanges" MaxLength="{x:Static add:AddEntryViewModel.MaxNoteLength}" SemanticProperties.Description="{loc:Translate Add_Note}"/>
                            </Border>
                            <Label Text="{Binding EditNoteLengthHint}" Style="{StaticResource Caption}"
                                   IsVisible="{Binding EditNoteLengthHint, Converter={StaticResource IsNotNull}}" />
                            <Label Text="{loc:Translate Add_When}" Style="{StaticResource Eyebrow}" CharacterSpacing="0.96" TextColor="{StaticResource SkyDeep}" />
                        </VerticalStackLayout>
                        <controls:TimingFields BindingContext="{Binding Timing}" />
                        <Button Text="{Binding SaveLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                        <Button Text="{loc:Translate Common_Cancel}" Style="{StaticResource NotNeededButton}" Command="{Binding CancelEditCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Delete, asked once more (Sand). -->
                <Border BackgroundColor="{StaticResource Sand}" Stroke="{StaticResource Sun}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                        Padding="14" IsVisible="{Binding IsConfirmingDelete}" controls:Accessible.FocusWhenShown="True">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource Body}" Text="{Binding DeleteQuestion}" TextColor="{StaticResource SandDeep}" />
                        <FlexLayout Wrap="Wrap">
                            <Button Text="{loc:Translate Check_DeleteYes}" Style="{StaticResource ConfirmButton}" Command="{Binding DeleteCommand}" />
                            <Button Text="{loc:Translate Common_KeepIt}" Style="{StaticResource KeepButton}" Command="{Binding KeepItCommand}" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource Caption}" Text="{Binding ErrorMessage}" controls:Accessible.Announce="True" TextColor="{StaticResource SandDeep}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
            </VerticalStackLayout>
        </DataTemplate>

        <!-- A check: node on the line, and a card that expands in place. The card and its chips are LightBorders: no layer
             or clip of their own, so rows coming into view as she scrolls cost little to draw. -->
        <DataTemplate x:Key="CheckTemplate" x:DataType="vm:CheckRow">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                <Grid RowDefinitions="30,*">
                    <ContentView WidthRequest="2" BackgroundColor="{StaticResource Line}" IsVisible="{Binding LineAbove}" />
                    <ContentView Grid.Row="1" WidthRequest="2" BackgroundColor="{StaticResource Line}" IsVisible="{Binding LineBelow}" />
                    <controls:LightBorder Grid.RowSpan="2" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,19,0,0"
                                          StrokeShape="RoundRectangle 11" StrokeThickness="2"
                                          BackgroundColor="{Binding StatusKind, Converter={StaticResource StatusNodeFill}}"
                                          Stroke="{Binding StatusKind, Converter={StaticResource StatusNodeRing}}" />
                    <controls:Icon Grid.RowSpan="2" Data="{StaticResource IconCheck}" Size="16" Color="{StaticResource White}"
                                   VerticalOptions="Start" Margin="0,24,0,0" IsVisible="{Binding IsDone}"
                                   controls:Motions.PopWhenShown="True" controls:Celebrate.When="{Binding IsDone}" />
                </Grid>

                <controls:LightBorder Grid.Column="1" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="0" Margin="0,3"
                                      BackgroundColor="{Binding CardKind, Converter={StaticResource StatusCard}}"
                                      Stroke="{Binding CardKind, Converter={StaticResource StatusCardBorder}}">
                    <VerticalStackLayout>
                        <!-- Header: tap to open or close. -->
                        <VerticalStackLayout Padding="16,13" Spacing="4" MinimumHeightRequest="44" controls:Accessible.Role="Expander" controls:Accessible.IsOn="{Binding IsExpanded}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <!-- An entry she added says what it is: "DOCTOR VISIT", "EXAM OR TEST", "HOSPITAL VISIT", "SOMETHING ELSE". -->
                            <Label Text="{Binding KindText}" Style="{StaticResource Eyebrow}" CharacterSpacing="0.88" IsVisible="{Binding HasKind}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding Title}" Style="{StaticResource Heading}"
                                       TextColor="{Binding StatusKind, Converter={StaticResource StatusTitle}}" VerticalOptions="Center" />
                                <controls:LightBorder Grid.Column="1" Style="{StaticResource Chip}" VerticalOptions="Center"
                                                      BackgroundColor="{Binding StatusKind, Converter={StaticResource StatusBackground}}">
                                    <Label Text="{Binding StatusText}" Style="{StaticResource Label}"
                                           TextColor="{Binding StatusKind, Converter={StaticResource StatusForeground}}" />
                                </controls:LightBorder>
                            </Grid>
                            <Label Text="{Binding Caption}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <!-- Expanded: note, booking, actions; built only while the card is open. -->
                        <controls:LazyView IsActive="{Binding IsExpanded}" ContentTemplate="{StaticResource CheckDetailTemplate}" />
                    </VerticalStackLayout>
                </controls:LightBorder>
            </Grid>
        </DataTemplate>

        <!-- One of her tasks on its day, at its week or first in its trimester (the "Tasks" switch on): the tick circle
             sits on the line, as on Today; tapping the row ticks it, or back. No card: tasks read lighter than her checks. -->
        <DataTemplate x:Key="TaskTemplate" x:DataType="vm:TaskRow">
            <Grid ColumnDefinitions="28,*" ColumnSpacing="12" MinimumHeightRequest="52"
                  SemanticProperties.Description="{Binding SpokenName}" SemanticProperties.Hint="{loc:Translate Week_TaskToggle}"
                  controls:Accessible.Role="CheckBox" controls:Accessible.IsOn="{Binding IsDone}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                </Grid.GestureRecognizers>
                <Grid RowDefinitions="12,24,*">
                    <ContentView WidthRequest="2" BackgroundColor="{StaticResource Line}" IsVisible="{Binding LineAbove}" />
                    <ContentView Grid.Row="2" WidthRequest="2" BackgroundColor="{StaticResource Line}" IsVisible="{Binding LineBelow}" />
                    <Grid Grid.Row="1" WidthRequest="24" HeightRequest="24" controls:Celebrate.When="{Binding IsDone}">
                        <controls:LightBorder StrokeShape="RoundRectangle 12" StrokeThickness="2" Stroke="{StaticResource Muted}" BackgroundColor="{StaticResource Mist}">
                            <controls:LightBorder.Triggers>
                                <DataTrigger TargetType="controls:LightBorder" Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Sage}" />
                                    <Setter Property="BackgroundColor" Value="{StaticResource Sage}" />
                                </DataTrigger>
                            </controls:LightBorder.Triggers>
                        </controls:LightBorder>
                        <controls:Icon Data="{StaticResource IconCheck}" Size="16" Color="{StaticResource White}"
                                       IsVisible="{Binding IsDone}" controls:Motions.PopWhenShown="True" />
                    </Grid>
                </Grid>
                <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="0,12">
                    <Label Style="{StaticResource Body}" Text="{Binding Title}" TextColor="{StaticResource Ink}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Muted}" />
                                <Setter Property="TextDecorations" Value="Strikethrough" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <controls:Icon Data="{StaticResource IconClock}" Size="16" Color="{StaticResource Sea}" />
                        <Label Grid.Column="1" Text="{Binding When}" Style="{StaticResource CaptionStrong}" TextColor="{StaticResource Sea}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>

        <!-- A blood pressure reading she logged on New, small on the line at the day and time she took it: a Sea dot, then
             a small Sea heart, "118/76 mmHg" and "Sat 10 Oct · 08:30", with no card. Never edited; slid left or right, it shows "Delete" (a
             Sand pill), which deletes it for good. -->
        <DataTemplate x:Key="ReadingTemplate" x:DataType="vm:ReadingRow">
            <SwipeView Threshold="112">
                <SwipeView.LeftItems>
                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                        <SwipeItemView Command="{Binding DeleteCommand}" WidthRequest="112">
                            <controls:LightBorder Style="{StaticResource Chip}" BackgroundColor="{StaticResource Sand}" StrokeShape="RoundRectangle 20"
                                                  Padding="16,8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{loc:Translate Check_Delete}" Style="{StaticResource Label}" TextColor="{StaticResource SandDeep}" />
                            </controls:LightBorder>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.LeftItems>
                <SwipeView.RightItems>
                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                        <SwipeItemView Command="{Binding DeleteCommand}" WidthRequest="112">
                            <controls:LightBorder Style="{StaticResource Chip}" BackgroundColor="{StaticResource Sand}" StrokeShape="RoundRectangle 20"
                                                  Padding="16,8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{loc:Translate Check_Delete}" Style="{StaticResource Label}" TextColor="{StaticResource SandDeep}" />
                            </controls:LightBorder>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.RightItems>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="12" MinimumHeightRequest="44" BackgroundColor="Transparent"
                      SemanticProperties.Description="{Binding SpokenName}" SemanticProperties.Hint="{loc:Translate Reading_SwipeHint}">
                    <Grid RowDefinitions="22,*">
                        <ContentView WidthRequest="2" BackgroundColor="{StaticResource Line}" IsVisible="{Binding LineAbove}" />
                        <ContentView Grid.Row="1" WidthRequest="2" BackgroundColor="{StaticResource Line}" IsVisible="{Binding LineBelow}" />
                        <Ellipse Grid.RowSpan="2" WidthRequest="10" HeightRequest="10" Fill="{StaticResource Sea}" VerticalOptions="Start" Margin="0,17,0,0" />
                    </Grid>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" Padding="0,12">
                        <controls:Icon Data="{StaticResource IconBloodPressure}" Size="16" Color="{StaticResource Sea}" VerticalOptions="Center" />
                        <Label Text="{Binding Value}" Style="{StaticResource Label}" TextColor="{StaticResource Ink}" />
                        <Label Text="{Binding When}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>
            </SwipeView>
        </DataTemplate>

        <views:PlanRowTemplateSelector x:Key="RowTemplates"
                                       Section="{StaticResource SectionTemplate}"
                                       Week="{StaticResource WeekTemplate}"
                                       Here="{StaticResource HereTemplate}"
                                       Check="{StaticResource CheckTemplate}"
                                       Task="{StaticResource TaskTemplate}"
                                       Reading="{StaticResource ReadingTemplate}" />
    </controls:MaiaPage.Resources>

    <CollectionView x:Name="Timeline" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplates}" SelectionMode="None" Margin="20,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="8" Padding="0,44,0,4" controls:Motions.Rise="True">
                <Label Text="{loc:Translate Plan_Title}" Style="{StaticResource Title}" />
                <Label Text="{loc:Translate Plan_Intro}" Style="{StaticResource Body}" />
                <!-- "Tasks": a switch that puts her tasks with a date on their day in the timeline, on until she turns it
                     off. The word, then the switch (its own 60 × 44 dp target), at the start under the intro. -->
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalOptions="Start">
                    <Label Text="{loc:Translate Plan_ShowTasks}" Style="{StaticResource Body}" VerticalOptions="Center" FontFamily="{DynamicResource FontTextSemiBold}" />
                    <controls:PillSwitch Grid.Column="1" IsToggled="{Binding ShowTasks}" VerticalOptions="Center" Label="{loc:Translate Plan_ShowTasks}" />
                </Grid>
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.Footer>
            <ContentView HeightRequest="28" />
        </CollectionView.Footer>
    </CollectionView>
</controls:MaiaPage>
